<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">


    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.univalle_mobile_dogapp_equipo_tres.view.fragment.LoginFragment"
        android:label="LoginFragment">

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.univalle_mobile_dogapp_equipo_tres.view.fragment.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_appointmentDetailFragment"
            app:destination="@id/appointmentDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_newAppointmentFragment"
            app:destination="@id/newAppointmentFragment" />
    </fragment>

    <fragment
        android:id="@+id/appointmentDetailFragment"
        android:name="com.example.univalle_mobile_dogapp_equipo_tres.view.fragment.AppointmentDetailFragment"
        android:label="AppointmentDetailFragment" />

    <fragment
        android:id="@+id/newAppointmentFragment"
        android:name="com.example.univalle_mobile_dogapp_equipo_tres.view.fragment.NewAppointmentFragment"
        android:label="NewAppointmentFragment" />

</navigation>
